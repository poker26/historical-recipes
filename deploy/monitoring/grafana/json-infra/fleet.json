{
 "uid": "fleet-selectel",
 "title": "Парк Selectel",
 "tags": [
  "infra"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "id": 1,
   "title": "Сайты снаружи (проверка с малинки)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "probe_success{job=\"blackbox_external\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "не отвечает",
         "color": "red"
        },
        "1": {
         "text": "работает",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "title": "Внутренние службы",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "probe_success{job=~\"blackbox_internal_.*\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "не отвечает",
         "color": "red"
        },
        "1": {
         "text": "работает",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "title": "Дней до конца сертификата",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox_external\"} - time()) / 86400",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 14
       },
       {
        "color": "green",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "basic",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "title": "Время ответа сайтов",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "probe_duration_seconds{job=\"blackbox_external\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Процессор, %",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Память занята, %",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 8,
    "y": 22,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Диск / занят, %",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 16,
    "y": 22,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Нагрузка (load 5 мин)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "node_load5",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Сеть наружу, байт/с",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus_selectel"
   },
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus_selectel"
     },
     "expr": "sum by (host) (rate(node_network_transmit_bytes_total{device=~\"eth0\"}[5m]))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}