              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n   \"prefetch\": $json.prefetchQueries ,\n  \"query\": {\n    \"fusion\": \"rrf\"\n  },\n  \"limit\": 10,\n  \"with_payload\": true,\n  \"with_vector\": false\n}\n}}",
        "options": {
          "allowUnauthorizedCerts": false
        }
