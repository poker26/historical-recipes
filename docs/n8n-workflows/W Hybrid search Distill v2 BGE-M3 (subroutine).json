      "name": "Get BGE-M3 vectors"
    },
    {
      "parameters": {
        "jsCode": "// Подготовка prefetch запросов для гибридного поиска\n// BGE-M3 возвращает и dense, и sparse в одном ответе\nconst response = $input.first().json;\nconst dense = response.results[0].dense;\nconst sparse = response.results[0].sparse;\n\nconsole.log(`Dense: ${dense.length} dims, Sparse: ${sparse.indices.length} tokens`);\n\nconst prefetchQueries = [\n  {\n    query: dense,\n    using: \"dense\",\n    limit: 20\n  },\n  {\n    query: {\n      indices: sparse.indices,\n      values: sparse.values\n    },\n    using: \"sparse\",\n    limit: 20\n  }\n];\n\nreturn {\n  json: {\n    prefetchQueries: prefetchQueries,\n    totalPrefetches: prefetchQueries.length\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        0
      ],
      "id": "5182a175-d253-4c05-886e-7f53c4356d33",
      "name": "Prepare Hybrid Query"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://gopa.begemot26.ru/collections/distill_hybrid_v2/points/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
