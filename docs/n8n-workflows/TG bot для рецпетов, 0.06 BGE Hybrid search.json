    {
      "parameters": {
        "jsCode": "const text = $json.output; // Замените 'response' на поле с текстом от AI Agent\nconst maxLength = 4096; // Лимит Telegram\n\nconst messages = [];\nlet currentMessage = '';\n\n// Разделение текста по переносам строк\nconst lines = text.split('\\n');\n\nfor (const line of lines) {\n  if (currentMessage.length + line.length + 1 <= maxLength) {\n    currentMessage += line + '\\n';\n  } else {\n    if (currentMessage) messages.push(currentMessage.trim());\n    currentMessage = line + '\\n';\n  }\n}\n\nif (currentMessage) messages.push(currentMessage.trim());\n\nreturn messages.map(msg => ({ json: { messageText: msg } }));"
      },
