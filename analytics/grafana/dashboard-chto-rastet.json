{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Postgres (Supabase)",
      "description": "Read-only datasource (grafana_ro) on the Supabase Postgres",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "title": "Что растёт — аналитика приложения",
  "uid": "chto-rastet-app",
  "tags": ["chto-rastet", "app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30m",
  "time": { "from": "now-90d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Всего устройств",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT count(*) AS value FROM quest_devices" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Всего определений",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT count(*) AS value FROM identifications" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Активные устройства (7 дней)",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT count(DISTINCT device_key) AS value FROM identifications WHERE created_at > now() - interval '7 days'" } ]
    },
    {
      "id": 4, "type": "gauge", "title": "Снимков «в корпусе», %",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 40 }, { "color": "green", "value": 70 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE matched_plant_id IS NOT NULL) / nullif(count(*),0), 1) AS value FROM identifications WHERE $__timeFilter(created_at)" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Новые устройства в день",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "showLegend": false } },
      "targets": [ { "refId": "A", "format": "time_series", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(created_at,'1d'), count(*) AS \"Новые устройства\" FROM quest_devices WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Определения в день",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "showLegend": false } },
      "targets": [ { "refId": "A", "format": "time_series", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(created_at,'1d'), count(*) AS \"Определения\" FROM identifications WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Активные устройства в день (DAU)",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "showLegend": false } },
      "targets": [ { "refId": "A", "format": "time_series", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(created_at,'1d'), count(DISTINCT device_key) AS \"DAU\" FROM identifications WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1" } ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Версии приложения (определений в день)",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "placement": "right" } },
      "targets": [ { "refId": "A", "format": "time_series", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT $__timeGroup(created_at,'1d') AS time, coalesce(app_version,'?') AS metric, count(*) AS value FROM identifications WHERE $__timeFilter(created_at) GROUP BY 1, app_version ORDER BY 1" } ]
    },
    {
      "id": 9, "type": "piechart", "title": "Платформа (по определениям)",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "pieType": "donut", "legend": { "showLegend": true, "placement": "right", "values": ["value", "percent"] } },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT CASE WHEN device_manufacturer ILIKE 'apple%' OR device_model ILIKE 'iphone%' OR device_model ILIKE 'ipad%' THEN 'iOS' WHEN COALESCE(os_sdk,0) > 0 OR device_manufacturer IS NOT NULL THEN 'Android' ELSE 'неизвестно' END AS platform, count(*) AS \"определений\" FROM identifications WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC" } ]
    },
    {
      "id": 10, "type": "table", "title": "Топ определяемых видов",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 9, "w": 16, "x": 8, "y": 20 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT coalesce(top_latin,'(не определено)') AS \"Вид\", count(*) AS \"Определений\", count(*) FILTER (WHERE matched_plant_id IS NOT NULL) AS \"В корпусе\" FROM identifications WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 25" } ]
    },
    {
      "id": 11, "type": "geomap", "title": "География определений",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "view": { "id": "coords", "lat": 55, "lon": 50, "zoom": 3 },
        "basemap": { "type": "default", "name": "Layer 0" },
        "layers": [ { "type": "markers", "name": "Определения", "location": { "mode": "auto" },
          "config": { "showLegend": false, "style": { "size": { "fixed": 5 }, "color": { "fixed": "green" }, "opacity": 0.5 } } } ],
        "controls": { "showZoom": true, "mouseWheelZoom": true, "showAttribution": true }
      },
      "targets": [ { "refId": "A", "format": "table", "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "rawQuery": true, "rawSql": "SELECT lat, lng AS lon FROM identifications WHERE lat IS NOT NULL AND lng IS NOT NULL AND $__timeFilter(created_at) LIMIT 5000" } ]
    }
  ]
}
