# Copy to .env on the GPU VDS and adjust.

# --- Model ---------------------------------------------------------------
# The served model name MUST be identical for the server and the client.
# The user evaluated PaddleOCR-VL 1.5; a newer 1.6 also exists. Confirm the
# exact tag the image supports with:  docker run --rm <VLLM_IMAGE> paddleocr --help
VL_MODEL_NAME=PaddleOCR-VL-1.5-0.9B

# Official NVIDIA GPU image (CUDA >= 12.6, compute capability >= 8.0 — A4000 = 8.6 OK)
VLLM_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-genai-vllm-server:latest-nvidia-gpu

# --- Client --------------------------------------------------------------
# OpenAI-compatible base URL of the server, reachable from the batch container.
VL_SERVER_URL=http://vllm-server:8118/v1
