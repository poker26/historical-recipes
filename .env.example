# === Database (Supabase self-hosted) ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@supabase-db:5432/postgres
POSTGRES_PASSWORD=postgres

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=historical-recipes
MINIO_SECURE=false

# === Qdrant (self-hosted) ===
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_RECIPES=recipes
QDRANT_COLLECTION_HERBALISM=herbalism

# === BGE-M3 (self-hosted embeddings) ===
BGE_M3_URL=http://172.17.0.1
BGE_M3_PORT=8100
BGE_M3_TIMEOUT=60.0

# === OpenRouter (LLM gateway) ===
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === LLM Models ===
LLM_MODEL_DEFAULT=qwen/qwen3-235b-a22b
LLM_MODEL_OCR_FALLBACK=google/gemini-2.5-flash
LLM_MODEL_OCR_HARD=google/gemini-2.5-pro
LLM_MODEL_LIGHTWEIGHT=qwen/qwen3-32b

# === n8n ===
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=

# === OCR ===
TESSERACT_LANG=rus
OCR_CONFIDENCE_AUTO=80.0
OCR_CONFIDENCE_REVIEW=60.0

# === CORS ===
CORS_ORIGINS=["http://localhost:3000"]

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
