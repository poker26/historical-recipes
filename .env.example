# === Database (Supabase) ===
# Формат: postgresql+asyncpg://postgres.TENANT_ID:PASSWORD@HOST:PORT/postgres
DATABASE_URL=postgresql+asyncpg://postgres.your-tenant-id:YOUR_PASSWORD@sup.begemot26.ru:6543/postgres

# === MinIO ===
# Реальный адрес вашего MinIO (домен:порт или IP:порт)
MINIO_ENDPOINT=minio.begemot26.ru:9000
MINIO_ACCESS_KEY=YOUR_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_SECRET_KEY
MINIO_BUCKET=historical-recipes
MINIO_SECURE=false

# === Qdrant ===
QDRANT_URL=http://qdrant.begemot26.ru:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_RECIPES=recipes
QDRANT_COLLECTION_HERBALISM=herbalism

# === BGE-M3 (эмбеддинги) ===
BGE_M3_URL=http://bge.begemot26.ru
BGE_M3_PORT=8100
BGE_M3_TIMEOUT=60.0

# === OpenRouter (LLM gateway) ===
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === LLM Models ===
LLM_MODEL_DEFAULT=qwen/qwen3-235b-a22b
LLM_MODEL_OCR_FALLBACK=google/gemini-2.5-flash
LLM_MODEL_OCR_HARD=google/gemini-2.5-pro
LLM_MODEL_LIGHTWEIGHT=qwen/qwen3-32b

# === n8n ===
N8N_BASE_URL=http://n8n.begemot26.ru:5678
N8N_WEBHOOK_SECRET=

# === OCR ===
TESSERACT_LANG=rus
OCR_CONFIDENCE_AUTO=80.0
OCR_CONFIDENCE_REVIEW=60.0

# === CORS ===
CORS_ORIGINS=["*"]

# === Nginx ===
NGINX_HTTP_PORT=80

# === Frontend ===
NEXT_PUBLIC_API_URL=/api
